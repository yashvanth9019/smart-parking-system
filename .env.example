# Backend & Database Environment Configuration
APP_NAME="SmartPark RTD - Smart Parking Management System"
ENVIRONMENT=development
DEBUG=true

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_parking_db

# JWT Security Configuration (change JWT_SECRET_KEY in production)
JWT_SECRET_KEY=super-secret-smart-parking-rtd-jwt-key-2026-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
QR_HMAC_SECRET=smart-parking-qr-verification-secret-2026

# Server & CORS
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005

# Background Expiry Monitor (seconds)
EXPIRY_CHECK_INTERVAL_SECONDS=30
EXPIRY_WARNING_MINUTES=15

# IoT Simulator Configuration
IOT_API_BASE_URL=http://localhost:8000
IOT_API_KEY=esp32-smartpark-device-key-2026
SIMULATOR_INTERVAL_SECONDS=5

